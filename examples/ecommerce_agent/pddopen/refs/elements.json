        { "level": 7, "tag": "DIV", "class": "RPR_tableWrapper_*", "description": "日期表格包裹" }
      ],
      "panelContainer": "两个 RPR_outerPickerWrapper_* 是兄弟节点，通过 parentElement 找同一容器内的所有面板"
    },
    "matchingStrategy": {
      "description": "日期匹配策略（抗分辨率/缩放）",
      "step1": "获取所有 RPR_outerPickerWrapper_*（按 DOM 顺序 = 左右顺序）",
      "step2": "在每个 outerWrapper 内查询 RPR_dateText_* 获取月份文本（如 '3月'）",
      "step3": "解析目标日期月份 parseInt(date.split('-')[1])，匹配对应面板",
      "step4": "在对应面板内查询 td.RPR_tdDay_*，排除 RPR_outOfMonth_*，匹配目标日期",
      "benefit": "不依赖坐标，完全抗分辨率/缩放/窗口大小变化"
    },
