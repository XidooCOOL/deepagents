  "calendar": {
    "_meta": {
      "description": "日历选择器通用组件（销售/客服页面通用）",
      "note": "月份标题是动态的（当前月-1 和 当前月），不依赖固定文本。核心策略：通过 DOM 结构（而非坐标）判断日期归属面板"
    },
    "domStructure": {
      "description": "DOM 结构（从上到下）",
      "chain": [
        { "level": 1, "tag": "SPAN", "class": "RPR_dateText_*", "description": "月份标题（如'3月'）" },
        { "level": 2, "tag": "DIV", "class": "RPR_headerSelector_*", "description": "标题容器" },
        { "level": 3, "tag": "SECTION", "class": "RPR_panelHeader_*", "description": "面板头部（包含月份和箭头）" },
        { "level": 4, "tag": "DIV", "class": "RPR_headerWrapper_*", "description": "头部包裹" },
        { "level": 5, "tag": "DIV", "class": "RPR_outerPickerWrapper_*", "description": "外层包裹（每个面板的根）" },
